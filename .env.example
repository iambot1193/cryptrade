POSTGRES_DB=cryptrade
POSTGRES_USER=cryptrade
POSTGRES_PASSWORD=cryptrade

# demo = precos falsos deterministicos (sem chamar CoinGecko), evita 429/rede na demo
SPRING_PROFILES_ACTIVE=demo

# Chave do validador que assina cada bloco do ledger. Fixa aqui de proposito para a demo:
# sem isso o processo gera uma chave nova a cada boot e um restart faz /ledger/verify
# acusar adulteracao em blocos legitimos assinados antes do restart. Gere a sua com
# SignatureVerifier.generateKeyPair() para qualquer uso alem da demo local.
CRYPTRADE_VALIDATOR_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIEr1IKFAObh0LTNCtv4dscSDt54hrPVCy9dKIZOS5Oia
CRYPTRADE_VALIDATOR_PUBLIC_KEY=MCowBQYDK2VwAyEANFjxiLyVil6aKuim/G4lAD3/0sbxC3z//z3EBJhqhu0=

# Segredo HMAC pra assinar o access/refresh token de sessao (conveniencia, nao e a
# autorizacao do lancamento - isso e a assinatura Ed25519 do cliente). Fixo so pra demo.
CRYPTRADE_JWT_SECRET=26J0HC0JGhwfvjUUnFE+4ACUhsxBHJNUKsYjZShW6Ss=

# Address que vira ADMIN ao logar (ve GET /admin/audit). Vazio = ninguem e admin.
# Preencha depois de criar sua primeira conta via POST /accounts.
CRYPTRADE_ADMIN_ADDRESS=
